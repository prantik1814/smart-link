# Supabase (frontend-safe: anon key only, never the service role key)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Razorpay public key id (safe for frontend; secret stays in Edge Functions)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# GitHub OAuth proxy (oauth-proxy.js only — never exposed to the browser)
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
